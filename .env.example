# ── Auth ──────────────────────────────────────────────────────────
CNC_ADMIN_USER=admin
CNC_ADMIN_PASSWORD=change-me-before-exposing
CNC_SECRET=                      # token-signing key; auto-generated+persisted if blank

# ── Persistence ───────────────────────────────────────────────────
CNC_DB=cnc/data/quotes.db        # SQLite path (use a durable volume in prod)

# ── Live material prices (optional) ───────────────────────────────
CNC_PRICE_FEED=none              # none | sina  (SHFE via hq.sinajs.cn)
CNC_PRICE_TTL=900

# ── AI copilot (optional; mock until set) ─────────────────────────
AI_PROVIDER=mock                 # mock | anthropic | openai
# AI_API_KEY=sk-...              # OpenAI-compatible key (keep out of git!)
# AI_BASE_URL=https://api.vectorengine.ai/v1
# ANTHROPIC_API_KEY=sk-ant-...   # for AI_PROVIDER=anthropic
AI_MODEL=claude-opus-4-8
# AI_TEMPERATURE=0.7
AI_PUBLIC=0                      # 1 = allow unauthenticated AI when a live model is wired
